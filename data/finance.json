   "q": "كيف يمكن للطالبة الاشتراك في السكن الداخلي في الجامعة؟",
   "a": "تقوم الطالبة بمراجعة مشرفة السكن الداخلي لحجز الغرفة المطلوبة وتعبئة الاستمارة الخاصة بذلك ثم تتوجه لدفع القيمة المترتبة المذكورة في الاستمارة الى صندوق الجامعة في الدائرة المالية تمهيدا لاستلام الغرفة.",
   "links": []
  },
  {
   "id": 33,
   "q": "ماذا يتوجب ان تفعل الطالبة في حال ارادت عدم تجديد الاشتراك في السكن والانسحاب منه؟",
   "a": "يتوجب على الطالبة افراغ الغرفة من اغراضها الشخصية وتسليم مفتاح الغرفة لمشرفة السكن والحصول على براءة ذمة السكن الداخلي.",
   "links": []
  },
